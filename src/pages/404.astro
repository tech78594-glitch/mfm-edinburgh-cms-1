---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="section section--plum on-dark" style="min-height:60vh;display:flex;align-items:center">
    <div class="container stack" style="--gap:20px;max-width:760px">
      <span class="eyebrow">Error 404</span>
      <h1 class="h1">We couldn’t find that page</h1>
      <p class="lead">It may have moved when we redesigned the website. Try one of these instead:</p>
      <div class="cluster"><a class="btn btn--accent" href="/">Home page</a><a class="btn btn--ghost" href="/services/">Service times</a><a class="btn btn--ghost" href="/contact/">Contact us</a></div>
    </div>
  </section>
</Base>
