---
// Home page slideshow (Figma: Home › Hero slideshow).
// Slides move sideways like a filmstrip on a timer and loop seamlessly (a copy of the first slide
// sits at the end). Behind each poster a blurred copy keeps drifting and zooming slowly.
// Accessible carousel (WCAG 2.2.2 without a separate button): the current dot pauses/plays,
// all motion freezes while paused, autoplay stops after 3 rounds, pauses on hover/keyboard focus, ← → keys, swipe that follows the finger,
// one labelled dot per slide, and no autoplay for visitors who prefer reduced motion.
import hero from '../data/hero.json';
import Icon from './Icon.astro';
import { safeUrl } from '../lib/format.js';
const slides = (hero.slides || []).filter((s) => s.title && safeUrl(s.image));
const seconds = Math.max(4, Number(hero.seconds_per_slide) || 7);
---
<section class="hero-slider on-dark" data-hero-slider data-interval={seconds} aria-roledescription="carousel" aria-label="Highlights" style={`--slide-ms:${seconds * 1000}ms`}>
  <h1 class="visually-hidden">MFM Edinburgh: a house of prayer in the heart of Leith</h1>
  <div class="hero-slider__track" aria-live="off">
    {slides.map((s, i) => (
      <div class:list={['hero-slide', { 'is-active': i === 0 }]} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
        <img class="hero-slide__bg" src={s.image} alt="" aria-hidden="true" loading={i ? 'lazy' : 'eager'} />
        <div class="container hero-slide__inner">
          <div class="hero-slide__copy">
            {i === 0 && <span class="tag">2026 · Year of Great Deliverance &amp; Fresh Glory</span>}
            {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
            <h2 class="h1 hero-slide__title">{s.title}</h2>
            {s.text && <p class="lead">{s.text}</p>}
            <div class="cluster">
              {s.button_text && safeUrl(s.button_link) && <a class="btn btn--accent" href={safeUrl(s.button_link)}>{s.button_text} <Icon name="arrow" size={20} /></a>}
              {s.button2_text && safeUrl(s.button2_link) && <a class="btn btn--ghost" href={safeUrl(s.button2_link)}>{s.button2_text}</a>}
            </div>
          </div>
          <figure class="hero-slide__media"><img src={s.image} alt={s.alt || s.title} loading={i ? 'lazy' : 'eager'} /></figure>
        </div>
      </div>
    ))}
  </div>
  <div class="container hero-slider__controls-wrap">
    <div class="hero-slider__controls" data-controls>
      <button class="hero-ctrl" type="button" data-prev aria-label="Previous slide"><Icon name="prev" size={22} /></button>
      <div class="hero-dots">
        {slides.map((s, i) => (
          <button class="hero-dot" type="button" data-dot={i} data-title={s.title} aria-label={`Slide ${i + 1} of ${slides.length}: ${s.title}`} aria-current={i === 0 ? 'true' : undefined}><span></span></button>
        ))}
      </div>
      <button class="hero-ctrl" type="button" data-next aria-label="Next slide"><Icon name="next" size={22} /></button>
    </div>
  </div>
</section>

<style>
  .hero-slider { position: relative; background: var(--plum); color: var(--white); overflow: hidden; isolation: isolate; }
  .hero-slider__track { display: flex; transform: translate3d(calc(var(--pos, 0) * -100% + var(--drag, 0px)), 0, 0); transition: transform 1s cubic-bezier(.77, 0, .18, 1); will-change: transform; touch-action: pan-y; }
  .hero-slider__track.is-jumping, .hero-slider__track.is-dragging { transition: none; }
  .hero-slide { flex: 0 0 100%; min-width: 0; position: relative; display: flex; align-items: center; overflow: hidden; isolation: isolate; }
  /* Thin light edge between slides as they pass */
  .hero-slide + .hero-slide { box-shadow: -1px 0 0 rgba(255,255,255,.14); }

  /* Background layer: blurred copy of the poster, always drifting */
  .hero-slide__bg { position: absolute; inset: -60px; width: calc(100% + 120px); height: calc(100% + 120px); max-width: none; object-fit: cover; filter: blur(30px) saturate(1.3); z-index: -2; transform: scale(1.12); }
  .hero-slide.is-active .hero-slide__bg { animation: bg-drift calc(var(--slide-ms) * 2.4) ease-in-out infinite alternate; }
  @keyframes bg-drift {
    0% { transform: scale(1.12) translate3d(0, 0, 0) rotate(0deg); }
    50% { transform: scale(1.28) translate3d(-3%, -2%, 0) rotate(1.5deg); }
    100% { transform: scale(1.2) translate3d(2.5%, 1.5%, 0) rotate(-1deg); }
  }
  .hero-slide::before { content: ""; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgba(87,11,117,.95) 0%, rgba(87,11,117,.86) 45%, rgba(87,11,117,.5) 100%), linear-gradient(0deg, rgba(29,27,32,.4), rgba(29,27,32,0) 45%); }

  .hero-slide__inner { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 56px; align-items: center; padding-block: 64px 176px; min-height: 680px; }
  .hero-slide__copy { display: flex; flex-direction: column; gap: 20px; }
  .hero-slide__copy .tag { align-self: flex-start; }
  .hero-slide__copy .lead { max-width: 34em; }

  /* Caption and poster ease in */
  .hero-slide__media { transition: transform .9s cubic-bezier(.2,.7,.2,1); }
  /* Outgoing slide keeps its words as it leaves; the incoming caption glides in once the slide lands. */
  .hero-slide.is-active .hero-slide__copy > * { animation: copy-in .8s cubic-bezier(.2,.7,.2,1) .45s both; }
  .hero-slide.is-active .hero-slide__copy > :nth-child(2) { animation-delay: .53s; }
  .hero-slide.is-active .hero-slide__copy > :nth-child(3) { animation-delay: .61s; }
  .hero-slide.is-active .hero-slide__copy > :nth-child(4) { animation-delay: .69s; }
  .hero-slide.is-active .hero-slide__copy > :nth-child(5) { animation-delay: .77s; }
  .hero-slide.is-settled .hero-slide__copy > * { animation: none; }
  @keyframes copy-in { from { opacity: 0; transform: translateX(60px); } to { opacity: 1; transform: none; } }
  /* Parallax: the poster travels a little slower than the slide */
  .hero-slide:not(.is-active) .hero-slide__media { transform: translateX(14%) scale(.94); }
  .hero-slide.is-active .hero-slide__media { transition-duration: 1.1s; transition-delay: .1s; }
  .hero-slider__track.is-jumping .hero-slide__media { transition: none; }

  .hero-slide__media { display: flex; justify-content: center; }
  .hero-slide__media img { max-height: 440px; width: auto; border-radius: 18px; box-shadow: 0 30px 70px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.12); }
  .hero-slide.is-active .hero-slide__media img { animation: poster-float calc(var(--slide-ms) * 1.4) ease-in-out infinite alternate; }
  @keyframes poster-float { from { transform: translateY(0) scale(1); } to { transform: translateY(-8px) scale(1.03); } }

  .hero-slider__controls-wrap { position: absolute; left: 0; right: 0; bottom: 96px; z-index: 3; margin-inline: auto; }
  .hero-slider__controls { display: flex; align-items: center; gap: 10px; }
  .hero-ctrl { width: 46px; height: 46px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; border: 2px solid rgba(255,255,255,.7); background: rgba(29,27,32,.25); color: var(--white); cursor: pointer; }
  .hero-ctrl:hover { background: var(--white); color: var(--plum); border-color: var(--white); }
  .hero-ctrl :global(svg) { pointer-events: none; }
  .hero-dots { display: flex; gap: 4px; padding-inline: 6px; }
  .hero-dot { width: 44px; height: 44px; padding: 0; border: 0; background: none; cursor: pointer; display: flex; align-items: center; }
  .hero-dot span { position: relative; display: block; width: 100%; height: 5px; border-radius: 5px; background: rgba(255,255,255,.38); overflow: hidden; pointer-events: none; }
  .hero-dot span::after { content: ""; position: absolute; inset: 0; background: var(--orange); transform: scaleX(0); transform-origin: left; }
  .hero-dot[aria-current="true"] span::after { transform: scaleX(1); }
  .hero-dot.is-running span::after { animation: dot-fill var(--slide-ms) linear both; }
  @keyframes dot-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* Paused (by the current dot, hover, keyboard focus or after 3 rounds): every moving part freezes in place */
  .hero-slider.is-paused .hero-dot span::after,
  .hero-slider.is-paused .hero-slide__bg,
  .hero-slider.is-paused .hero-slide__media img { animation-play-state: paused; }
  /* Stopped by the visitor or after 3 rounds: the frozen bar turns white so the pause is visible */
  .hero-slider.is-stopped .hero-dot[aria-current="true"] span::after { background: var(--white); }

  /* Tooltip on the current dot ("Pause" / "Play") for mouse and keyboard users */
  .hero-dot { position: relative; }
  .hero-dot[aria-current="true"]::before { content: attr(data-tip); position: absolute; bottom: calc(100% + 2px); left: 50%; transform: translate(-50%, 4px); padding: 4px 10px; border-radius: 8px; background: var(--white); color: var(--plum); font-size: .875rem; font-weight: 700; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; }
  .hero-dot[aria-current="true"]:hover::before, .hero-dot[aria-current="true"]:focus-visible::before { opacity: 1; transform: translate(-50%, 0); }

  @media (max-width: 960px) {
    .hero-slide__inner { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-block: 28px 168px; min-height: 0; align-content: start; }
    .hero-slide__media { order: -1; }
    .hero-slide__media img { max-height: 260px; }
    .hero-slide::before { background: linear-gradient(180deg, rgba(87,11,117,.55) 0%, rgba(87,11,117,.9) 40%, rgba(87,11,117,.97) 100%); }
  }
  @media (max-width: 600px) {
    .hero-slide__inner { padding-block: 20px 156px; gap: 18px; }
    .hero-slide__media img { max-height: 200px; border-radius: 14px; }
    .hero-slide__title { font-size: 2.125rem; }
    .hero-slide__copy { gap: 14px; }
    .hero-slide__copy .cluster { flex-direction: column; align-items: stretch; }
    .hero-slider__controls-wrap { bottom: 84px; }
    .hero-slider__controls { gap: 4px; }
    .hero-dot { width: 32px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slider__track { transition-duration: .01s; }
    .hero-slide__copy > * { animation: none !important; }
    .hero-slide__media { transition: none !important; }
    .hero-slide__bg, .hero-slide__media img { animation: none !important; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ROUNDS = 3; // autoplay stops after this many full rounds
  document.querySelectorAll('[data-hero-slider]').forEach((root) => {
    const track = root.querySelector('.hero-slider__track');
    const slides = [...track.querySelectorAll('.hero-slide')];
    const dots = [...root.querySelectorAll('[data-dot]')];
    const n = slides.length;
    if (n < 2) { root.querySelector('[data-controls]')?.remove(); return; }
    const full = Math.max(4, parseFloat(root.dataset.interval) || 7) * 1000;

    // Copy of the first slide at the end, so the strip can keep sliding left and loop seamlessly.
    const clone = slides[0].cloneNode(true);
    clone.setAttribute('aria-hidden', 'true');
    clone.inert = true;
    clone.removeAttribute('aria-label');
    clone.querySelectorAll('a, button').forEach((el) => { el.tabIndex = -1; });
    track.appendChild(clone);
    const panels = [...slides, clone];

    let pos = 0, busy = false;
    // stopped: by the visitor (current dot) or after ROUNDS rounds. Reduced-motion visitors start stopped.
    let stopped = reduce, hover = false, focus = false, rounds = 0;
    let timer = 0, startedAt = 0, remaining = full, running = false;
    const index = () => pos % n;
    const paused = () => stopped || hover || focus || document.hidden;

    const label = () => {
      dots.forEach((d, i) => {
        const base = `Slide ${i + 1} of ${n}: ${d.dataset.title}`;
        if (i === index()) {
          d.setAttribute('aria-current', 'true');
          d.setAttribute('aria-label', `${base}. ${stopped ? 'Play' : 'Pause'} slideshow`);
          d.dataset.tip = stopped ? 'Play' : 'Pause';
        } else {
          d.removeAttribute('aria-current');
          d.setAttribute('aria-label', base);
          delete d.dataset.tip;
        }
      });
    };
    const jump = (p) => { // move without animation
      track.classList.add('is-jumping');
      pos = p; track.style.setProperty('--pos', p);
      panels.forEach((el, i) => { el.classList.toggle('is-active', i === p); el.classList.toggle('is-settled', i === p); });
      void track.offsetWidth;
      track.classList.remove('is-jumping');
    };
    const render = () => {
      track.style.setProperty('--pos', pos);
      panels.forEach((el, i) => { el.classList.toggle('is-active', i === pos); el.classList.remove('is-settled'); });
      slides.forEach((s, i) => {
        const on = i === index();
        s.setAttribute('aria-hidden', String(!on));
        s.querySelectorAll('a, button').forEach((el) => { el.tabIndex = on ? 0 : -1; });
      });
      label();
    };

    // Timer that can be frozen and resumed, kept in step with the progress bar.
    const freeze = () => { if (running) { clearTimeout(timer); remaining -= performance.now() - startedAt; running = false; } };
    const update = () => {
      root.classList.toggle('is-paused', paused());
      root.classList.toggle('is-stopped', stopped);
      track.setAttribute('aria-live', stopped || focus ? 'polite' : 'off');
      label();
      if (paused()) { freeze(); return; }
      if (!running) { startedAt = performance.now(); running = true; timer = setTimeout(auto, Math.max(0, remaining)); }
    };
    const restartBar = () => {
      freeze(); remaining = full;
      dots.forEach((d) => d.classList.remove('is-running'));
      void dots[index()].offsetWidth;
      dots[index()].classList.add('is-running');
    };
    const settle = () => { busy = false; if (pos === n) jump(0); };
    track.addEventListener('transitionend', (e) => { if (e.target === track && e.propertyName === 'transform') settle(); });

    const moveTo = (p) => {
      if (busy && pos === n) jump(0);
      pos = p; busy = !reduce; render(); restartBar(); update();
      if (reduce) settle();
    };
    const next = () => { if (pos === n) jump(0); moveTo(pos + 1); };
    const prev = () => {
      if (pos === n) jump(0);
      if (pos === 0) { jump(n); requestAnimationFrame(() => moveTo(n - 1)); return; }
      moveTo(pos - 1);
    };
    const go = (i) => moveTo(((i % n) + n) % n);
    // Autoplay step: after ROUNDS full rounds it lands on the first poster and stops.
    const auto = () => {
      running = false;
      if (index() === n - 1 && ++rounds >= ROUNDS) stopped = true;
      next();
    };
    const setStopped = (v) => { stopped = v; if (!v) rounds = 0; update(); };

    root.querySelector('[data-prev]').addEventListener('click', prev);
    root.querySelector('[data-next]').addEventListener('click', next);
    dots.forEach((d, i) => d.addEventListener('click', () => (i === index() ? setStopped(!stopped) : go(i))));
    root.addEventListener('mouseenter', () => { hover = true; update(); });
    root.addEventListener('mouseleave', () => { hover = false; update(); });
    // Pause for keyboard focus only; a mouse click or tap on an arrow shouldn't stop the slideshow.
    root.addEventListener('focusin', (e) => { if (e.target.matches(':focus-visible')) { focus = true; update(); } });
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget)) { focus = false; update(); } });
    document.addEventListener('visibilitychange', update);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }
      if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
    });

    // Swipe: the strip follows the finger, then snaps to the next or previous slide.
    let sx = null, sy = null, dx = 0, horiz = null;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      if (pos === n) jump(0);
      sx = e.clientX; sy = e.clientY; dx = 0; horiz = null; freeze();
    });
    track.addEventListener('pointermove', (e) => {
      if (sx == null) return;
      dx = e.clientX - sx;
      if (horiz == null && (Math.abs(dx) > 8 || Math.abs(e.clientY - sy) > 8)) horiz = Math.abs(dx) > Math.abs(e.clientY - sy);
      if (horiz) { track.classList.add('is-dragging'); track.style.setProperty('--drag', `${dx}px`); }
    });
    const end = () => {
      if (sx == null) return;
      sx = null;
      track.classList.remove('is-dragging'); track.style.setProperty('--drag', '0px');
      if (horiz && Math.abs(dx) > 50) (dx < 0 ? next : prev)(); else update();
    };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', end);

    root._hero = { go, next, prev, stop: () => setStopped(true), play: () => setStopped(false) };
    render(); restartBar(); update();
  });
</script>
