---
// Testimonies — look: wall of praise (oversized magenta quote mark, quote cards, the site's only form).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import testimonies from '../data/testimonies.json';
const items = (testimonies.items || []).filter((t) => t.show !== false && t.text);
const form = site.testimony_form || {};
const sendTo = form.send_to || site.emails[0];
---
<Base title="Testimonies" description="Read what God has done in the lives of the MFM Edinburgh church family, and share your own testimony.">
  <section class="section section--lilac tm-hero" aria-labelledby="page-title" style="--section-pad:72px">
    <div class="container stack" style="--gap:14px">
      <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Testimonies</span></nav>
      <span class="tm-hero__mark" aria-hidden="true">“</span>
      <h1 class="display" id="page-title">Testimonies</h1>
      <p class="lead" style="max-width:40em">“Let the redeemed of the Lord say so.” Psalm 107:2. Read what God has done in the lives of the church family — and share your own story.</p>
    </div>
  </section>

  <section class="section" aria-label="Testimonies and form">
    <div class="container tm-grid">
      <div class="stack" style="--gap:20px">
        <span class="eyebrow">Stories from the church family</span>
        {items.length ? (
          <ul role="list" class="wall">
            {items.map((t) => (
              <li class="wall__card">
                <span class="wall__mark" aria-hidden="true">“</span>
                <blockquote><p>{t.text}</p></blockquote>
                {t.name && <p class="wall__name">— {t.name}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <div class="tm-empty on-dark">
            <h2 class="h3s">Be the first to share</h2>
            <p>Testimonies appear here once the church office has read them and the person has agreed to share. Has God answered your prayer? Tell us.</p>
          </div>
        )}
      </div>

      <form class="tm-form" id="share" data-testimony-form data-endpoint={form.endpoint || ''} data-to={sendTo}
            action={form.endpoint || `mailto:${sendTo}?subject=${encodeURIComponent('Testimony from the website')}`}
            method="post" enctype={form.endpoint ? undefined : 'text/plain'} novalidate aria-labelledby="form-title">
        <h2 class="tm-form__title" id="form-title">Share your testimony</h2>
        <div class="field">
          <label for="t-name">Your name</label>
          <input id="t-name" name="name" autocomplete="name" required data-label="name" aria-describedby="t-name-err" />
          <p class="field__err" id="t-name-err" hidden></p>
        </div>
        <div class="field">
          <label for="t-email">Email address <span class="muted">(optional)</span></label>
          <input id="t-email" name="email" type="email" autocomplete="email" data-label="email address" aria-describedby="t-email-hint t-email-err" />
          <p class="field__hint" id="t-email-hint">So we can thank you. We never publish it.</p>
          <p class="field__err" id="t-email-err" hidden></p>
        </div>
        <div class="field">
          <label for="t-text">Your testimony</label>
          <textarea id="t-text" name="testimony" rows="6" required data-label="testimony" aria-describedby="t-text-err"></textarea>
          <p class="field__err" id="t-text-err" hidden></p>
        </div>
        <label class="check"><input type="checkbox" name="may_publish" value="yes" /> <span>You can share this on the church website</span></label>
        <button class="btn btn--primary" type="submit">Send my testimony</button>
        <p class="tm-form__status" role="status" hidden></p>
        <p class="field__hint">The church office reads every testimony before anything is published.</p>
      </form>
    </div>
  </section>

  <section class="section section--plum on-dark" aria-label="Scripture" style="--section-pad:72px">
    <div class="container tm-verse">
      <p>“And they overcame him by the blood of the Lamb, and by the word of their testimony.”</p>
      <span class="eyebrow">Revelation 12:11</span>
    </div>
  </section>
</Base>

<style>
  .tm-hero__mark { font-family: var(--font-serif); font-weight: 700; font-size: 10rem; line-height: .6; color: var(--magenta); margin-top: 24px; height: 72px; }
  .tm-hero .display { color: var(--plum); }
  .tm-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: clamp(24px, 0.9rem + 2vw, 48px); align-items: start; }
  .wall { columns: 2 280px; column-gap: 20px; }
  .wall__card { break-inside: avoid; margin-bottom: 20px; background: var(--white); border: 1px solid var(--line); border-radius: 22px; padding: clamp(20px, 0.9rem + 0.7vw, 28px); display: flex; flex-direction: column; gap: 12px; }
  .wall__card:nth-child(3n+2) { background: var(--lilac); border-color: var(--lilac); }
  .wall__mark { font-family: var(--font-serif); font-weight: 700; font-size: 4rem; line-height: .5; color: var(--magenta); height: 28px; }
  .wall blockquote { font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.45; }
  .wall__name { font-weight: 600; color: var(--purple); }
  .tm-empty { background: var(--plum); color: var(--white); border-radius: var(--r-panel); padding: clamp(22px, 0.9rem + 1vw, 32px); display: flex; flex-direction: column; gap: 12px; }
  .tm-empty p { color: var(--lilac); }
  .tm-form { position: sticky; top: calc(var(--header-h) + 24px); background: var(--white); border: 1px solid var(--line); border-radius: 28px; padding: clamp(24px, 4vw, 36px); box-shadow: 0 20px 50px rgba(87, 11, 117, .12); display: flex; flex-direction: column; gap: 18px; }
  .tm-form__title { font-family: var(--font-serif); font-size: 1.75rem; color: var(--plum); display: flex; align-items: center; gap: 12px; }
  .tm-form__title::before { content: ""; width: 6px; height: 28px; border-radius: 3px; background: var(--magenta); }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-weight: 600; }
  .field input, .field textarea { width: 100%; min-height: 52px; padding: 12px 16px; border: 2px solid #8A8F94; border-radius: 12px; font: inherit; font-size: 1.0625rem; color: var(--ink); background: var(--white); }
  .field textarea { resize: vertical; min-height: 150px; }
  .field input:hover, .field textarea:hover { border-color: var(--slate); }
  .field [aria-invalid="true"] { border-color: #B3261E; }
  .field__hint { font-size: .9375rem; color: var(--slate); }
  .field__err { color: #B3261E; font-weight: 600; font-size: 1rem; }
  .check { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; }
  .check input { width: 22px; height: 22px; margin: 2px 0 0; accent-color: var(--purple); flex: none; }
  .tm-form__status { padding: 12px 16px; border-radius: 12px; font-weight: 600; }
  .tm-form__status.ok { background: #E7F4EC; color: #1E6B3A; }
  .tm-form__status.err { background: #FCE8E6; color: #B3261E; }
  .tm-verse { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .tm-verse p { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.5rem, 3vw, 2.125rem); line-height: 1.3; max-width: 26em; }
  @media (max-width: 960px) { .tm-grid { grid-template-columns: minmax(0, 1fr); } .tm-form { position: static; } }
</style>

<script>
  // Validates, then sends to the configured endpoint (e.g. Formspree) or opens the visitor's email app.
  const form = document.querySelector('[data-testimony-form]');
  if (form) {
    const status = form.querySelector('.tm-form__status');
    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    const fields = [...form.querySelectorAll('input[required], textarea[required], input[type=email]')];
    const check = (el) => {
      const v = el.value.trim(); const label = el.getAttribute('data-label');
      if (el.required && !v) return `Enter your ${label}`;
      if (el.type === 'email' && v && !EMAIL.test(v)) return 'Enter a full email address, like name@example.com';
      return '';
    };
    const show = (el, msg) => {
      const err = document.getElementById(el.id + '-err');
      el.setAttribute('aria-invalid', msg ? 'true' : 'false');
      if (err) { err.textContent = msg; err.hidden = !msg; }
    };
    fields.forEach((el) => el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') show(el, check(el)); }));
    const say = (ok, msg) => { status.hidden = false; status.className = 'tm-form__status ' + (ok ? 'ok' : 'err'); status.textContent = msg; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let first = null;
      fields.forEach((el) => { const m = check(el); show(el, m); if (m && !first) first = el; });
      if (first) { first.focus(); return; }
      const data = new FormData(form);
      const endpoint = form.getAttribute('data-endpoint');
      if (endpoint) {
        const btn = form.querySelector('[type=submit]'); btn.disabled = true;
        try {
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error();
          form.reset(); say(true, 'Thank you for sharing. Praise God! The church office will read it soon.');
        } catch { say(false, 'Your testimony didn’t send. Please try again, or email ' + form.getAttribute('data-to') + '.'); }
        btn.disabled = false;
        return;
      }
      // No form service configured: open an email addressed to the church
      const body = `Name: ${data.get('name')}\nEmail: ${data.get('email') || '—'}\nMay publish on the website: ${data.get('may_publish') ? 'Yes' : 'No'}\n\n${data.get('testimony')}`;
      window.location.href = `mailto:${form.getAttribute('data-to')}?subject=${encodeURIComponent('Testimony from the website')}&body=${encodeURIComponent(body)}`;
      say(true, 'Your email app should open with your testimony ready to send. If it doesn’t, email ' + form.getAttribute('data-to') + '.');
    });
  }
</script>
