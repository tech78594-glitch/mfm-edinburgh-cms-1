---
// Gallery — look: dark exhibition (album filter chips, masonry, keyboard-friendly lightbox).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import gallery from '../data/gallery.json';
import videos from '../data/videos.json';
import VideoCard from '../components/VideoCard.astro';
import { prettyTitle } from '../lib/videos.js';
import MediaSwitch from '../components/MediaSwitch.astro';
import pictures from '../data/pictures.json';
const picTotal = pictures.chapters.reduce((n, r) => n + r.items.length, 0);
const picPreview = ['congregation-rejoicing', 'family-celebration', 'praise-team-joyful-noise'];
// Skip any service whose thumbnail is already in the photo albums above, so no image appears twice
const inAlbums = new Set(JSON.stringify(gallery).match(/vi\/([\w-]{11})\//g)?.map((m) => m.slice(3, -1)) ?? []);
const latest = videos.channels.edinburgh.items.filter((v) => !inAlbums.has(v.id)).slice(0, 3);
const albums = gallery.albums || [];
const photos = albums.flatMap((a) => a.items.map((p) => ({ ...p, album: a.slug, albumTitle: a.title })));
---
<Base title="Gallery" description="Photos from the life of MFM Edinburgh — services, programmes and the church family." dark>
  <div class="gal on-dark">
    <section class="container gal-hero" aria-labelledby="page-title">
      <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Gallery</span></nav>
      <MediaSwitch current="photos" />
      <div class="gal-hero__row">
        <div class="stack" style="--gap:12px">
          <h1 class="display" id="page-title">Gallery</h1>
          <p class="lead">Moments from the life of MFM Edinburgh — services, programmes and the church family.</p>
        </div>
        <p class="gal-hero__count"><span data-count>{photos.length}</span> photos · {albums.length} albums</p>
      </div>
      <div class="chips" role="group" aria-label="Filter by album">
        <button type="button" class="chip" aria-pressed="true" data-filter="all">All</button>
        {albums.map((a) => <button type="button" class="chip" aria-pressed="false" data-filter={a.slug}>{a.title}</button>)}
      </div>
    </section>

    <section class="container gal-grid" aria-label="Photos">
      <ul role="list" class="masonry">
        {photos.map((p, i) => (
          <li data-album={p.album}>
            <button type="button" class="tile" data-index={i} data-src={p.src} data-alt={p.alt}>
              <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading={i < 6 ? 'eager' : 'lazy'} />
            </button>
            <p class="tile__cap">{p.alt}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="gal-pics" aria-labelledby="gal-pics-title">
      <div class="container gal-pics__inner">
        <div class="stack gal-pics__copy" style="--gap:14px">
          <span class="eyebrow eyebrow--gold">New · The Picture Lookbook</span>
          <h2 class="h2" id="gal-pics-title">Scroll through our story in pictures</h2>
          <p class="lead">{picTotal} photographs of praise, prayer, the Word and church family, told in {pictures.chapters.length} chapters.</p>
          <a class="btn btn--accent" href="/pictures/">Open the Picture Gallery <Icon name="arrow" size={20} /></a>
        </div>
        <a class="gal-pics__frames" href="/pictures/" tabindex="-1" aria-hidden="true">
          {picPreview.map((f, i) => <span class:list={['gal-pics__frame', `gal-pics__frame--${i}`]}><span><img src={`/images/pictures/${f}-sm.jpg`} alt="" width="900" height="600" loading="lazy" /></span></span>)}
        </a>
      </div>
    </section>

    <section class="container gal-videos" aria-labelledby="gal-videos-title">
      <div class="gal-videos__head">
        <div class="stack" style="--gap:8px">
          <span class="eyebrow eyebrow--gold">Videos</span>
          <h2 class="h2" id="gal-videos-title">Watch services &amp; programmes</h2>
        </div>
        <a class="btn btn--accent" href="/videos/">See all videos <Icon name="arrow" size={20} /></a>
      </div>
      <ul role="list" class="grid" style="--min:280px;--gap:28px 24px">
        {latest.map((v) => <li><VideoCard id={v.id} title={prettyTitle(v.title)} meta="MFM Edinburgh" /></li>)}
      </ul>
    </section>

    <section class="gal-share" aria-labelledby="share-title">
      <div class="container gal-share__inner">
        <h2 class="h3s" id="share-title">Have photos from a service or programme? Send them to the church office.</h2>
        <a class="btn btn--accent" href={`mailto:${site.emails[0]}?subject=${encodeURIComponent('Photos for the website gallery')}`}><Icon name="image" size={20} /> Email your photos</a>
      </div>
    </section>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
    <div class="lightbox__inner">
      <figure><img alt="" data-lb-img /><figcaption><span class="eyebrow" data-lb-pos></span><span data-lb-cap></span></figcaption></figure>
      <button type="button" class="lb-btn lb-btn--close" data-lb-close aria-label="Close"><Icon name="close" /></button>
      <button type="button" class="lb-btn lb-btn--prev" data-lb-prev aria-label="Previous photo"><Icon name="prev" /></button>
      <button type="button" class="lb-btn lb-btn--next" data-lb-next aria-label="Next photo"><Icon name="next" /></button>
    </div>
  </dialog>
</Base>

<style>
  .gal { background: var(--ink); color: var(--white); }
  .gal-pics { position: relative; padding-block: var(--space-xl); background: radial-gradient(80% 90% at 75% 50%, #5a1680 0%, #2d0840 60%, #1D1B20 100%); overflow: hidden; }
  .gal-pics__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 1rem + 4vw, 80px); align-items: center; }
  .gal-pics__copy .btn { align-self: flex-start; }
  .gal-pics__frames { position: relative; display: block; height: clamp(260px, 30vw, 420px); perspective: 1000px; }
  .gal-pics__frame { position: absolute; width: 58%; padding: 2.2% 2.2% 9%; background: #fff; border-radius: 8px; box-shadow: 0 30px 50px rgba(0,0,0,.45); transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .gal-pics__frame > span { display: block; border-radius: 4px; overflow: hidden; }
  .gal-pics__frame img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .gal-pics__frame--0 { left: 21%; top: 12%; z-index: 3; transform: rotate(-2deg) translateZ(40px); }
  .gal-pics__frame--1 { left: 0; top: 0; z-index: 2; transform: rotate(-7deg) translateZ(-60px); }
  .gal-pics__frame--2 { right: 0; top: 22%; z-index: 1; transform: rotate(6deg) translateZ(-60px); }
  .gal-pics__frames:hover .gal-pics__frame--1 { transform: rotate(-11deg) translateX(-18px); }
  .gal-pics__frames:hover .gal-pics__frame--2 { transform: rotate(10deg) translateX(18px); }
  .gal-pics__frames:hover .gal-pics__frame--0 { transform: rotate(0deg) scale(1.04); }
  @media (max-width: 900px) { .gal-pics__inner { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .gal-pics__frame { transition: none; } }
  .gal-videos { padding-block: var(--space-l); border-top: 1px solid rgba(255, 255, 255, .12); }
  .gal-videos__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: var(--space-m); }
  .gal-hero { padding-block: clamp(48px, 1.5rem + 3vw, 96px) 32px; display: flex; flex-direction: column; gap: 24px; }
  .gal-hero__row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .gal-hero .lead { color: var(--line); max-width: 34em; }
  .gal-hero__count { font-weight: 600; color: var(--fire-yellow); }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { min-height: 44px; padding: 8px 20px; border-radius: var(--r-pill); border: 1.5px solid rgba(255,255,255,.4); background: transparent; color: var(--white); font-weight: 700; cursor: pointer; }
  .chip:hover { border-color: var(--white); }
  .chip[aria-pressed="true"] { background: var(--fire-yellow); border-color: var(--fire-yellow); color: var(--ink); }
  .gal-grid { padding-bottom: 96px; }
  .masonry { columns: 3 300px; column-gap: 20px; }
  .masonry li { break-inside: avoid; margin-bottom: 24px; }
  .masonry li[hidden] { display: none; }
  .tile { display: block; width: 100%; padding: 0; border: 0; background: var(--slate); border-radius: 16px; overflow: hidden; cursor: zoom-in; }
  .tile img { width: 100%; height: auto; transition: transform .4s ease, opacity .2s; }
  .tile:hover img { transform: scale(1.03); }
  .tile:focus-visible { outline-offset: 4px; }
  .tile__cap { margin-top: 10px; font-size: .9375rem; font-weight: 600; color: var(--line); }
  .gal-share { background: var(--plum); }
  .gal-share__inner { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; padding-block: var(--space-l); }
  .gal-share h2 { max-width: 24em; }
  .lightbox { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(0,0,0,.94); color: var(--white); }
  .lightbox::backdrop { background: rgba(0,0,0,.85); }
  .lightbox__inner { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 72px 88px; }
  .lightbox figure { display: flex; flex-direction: column; align-items: center; gap: 14px; max-width: 100%; max-height: 100%; }
  .lightbox img { max-width: 100%; max-height: calc(100vh - 200px); width: auto; border-radius: 12px; }
  .lightbox figcaption { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; font-weight: 600; }
  .lb-btn { position: absolute; width: 52px; height: 52px; border-radius: 50%; border: 2px solid rgba(255,255,255,.7); background: rgba(29,27,32,.4); color: var(--white); display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .lb-btn:hover { background: var(--white); color: var(--plum); }
  .lb-btn--close { top: 16px; right: 16px; }
  .lb-btn--prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lb-btn--next { right: 16px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 600px) { .lightbox__inner { padding: 72px 12px 96px; } .lb-btn--prev, .lb-btn--next { top: auto; bottom: 20px; transform: none; } .lb-btn--prev { left: calc(50% - 64px); } .lb-btn--next { right: calc(50% - 64px); } }
</style>

<script>
  // Album filter
  const chips = [...document.querySelectorAll('[data-filter]')];
  const items = [...document.querySelectorAll('.masonry li')];
  const count = document.querySelector('[data-count]');
  chips.forEach((c) => c.addEventListener('click', () => {
    const f = c.getAttribute('data-filter');
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    items.forEach((li) => { li.hidden = f !== 'all' && li.getAttribute('data-album') !== f; });
    if (count) count.textContent = String(items.filter((li) => !li.hidden).length);
  }));

  // Lightbox (native <dialog>: Esc closes and focus is managed by the browser)
  const dlg = document.querySelector('[data-lightbox]');
  const img = dlg.querySelector('[data-lb-img]'), cap = dlg.querySelector('[data-lb-cap]'), pos = dlg.querySelector('[data-lb-pos]');
  let list = [], i = 0, opener = null;
  const show = () => {
    const b = list[i];
    img.src = b.getAttribute('data-src'); img.alt = b.getAttribute('data-alt');
    cap.textContent = b.getAttribute('data-alt'); pos.textContent = `${i + 1} / ${list.length}`;
  };
  document.querySelectorAll('.tile').forEach((t) => t.addEventListener('click', () => {
    list = items.filter((li) => !li.hidden).map((li) => li.querySelector('.tile'));
    i = list.indexOf(t); opener = t; show();
    dlg.showModal(); document.body.classList.add('lightbox-open');
  }));
  const step = (d) => { i = (i + d + list.length) % list.length; show(); };
  dlg.querySelector('[data-lb-prev]').addEventListener('click', () => step(-1));
  dlg.querySelector('[data-lb-next]').addEventListener('click', () => step(1));
  dlg.querySelector('[data-lb-close]').addEventListener('click', () => dlg.close());
  dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') step(-1); if (e.key === 'ArrowRight') step(1); });
  dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target.classList.contains('lightbox__inner')) dlg.close(); });
  dlg.addEventListener('close', () => { document.body.classList.remove('lightbox-open'); opener?.focus(); });
</script>
