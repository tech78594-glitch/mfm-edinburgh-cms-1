    const intro = root.querySelector('[data-intro]');
    const stackWrap = root.querySelector('[data-stack-wrap]');
    const stackCards = [...root.querySelectorAll('[data-stack]')];
    const notes = [...root.querySelectorAll('[data-intro-note]')];
    const titleBox = root.querySelector('.lb-intro__title');
    const fan = [[-33, -22, -9], [32, -24, 7], [-36, 20, 6], [34, 22, -6], [-14, 34, -3], [16, -36, 4]];
    const fanMobile = [[-24, -30, -9], [25, -33, 7], [-25, 31, 6], [25, 33, -6], [0, 41, -3], [0, -41, 4]];
    const stackRot = [-8, 6, -3, 9, -5, 2];
    const paintIntro = () => {
      const r = intro.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      const p = progress(intro, intro.querySelector('.lb-stage'));
      const t = easeOut(clamp(p / .7));
      const m = mobile.matches;
      stackCards.forEach((c, i) => {
        const [fx, fy, fr] = (m ? fanMobile : fan)[i];
        const rot = stackRot[i] + (fr - stackRot[i]) * t;
        c.style.transform = `translate(-50%, -50%) translate3d(${fx * t}vw, ${fy * t}vh, 0) rotate(${rot}deg) scale(${1 - t * (m ? .42 : .32)})`;
      });
      stackWrap.classList.toggle('is-open', t > .85);
      titleBox.style.setProperty('--title-op', clamp((p - .12) / .4).toFixed(3));
      notes.forEach((nn) => nn.style.setProperty('--note-op', (1 - clamp(p / .18)).toFixed(3)));
    };

    // Feature photos: a small window that opens to the full screen
    const heroes = [...root.querySelectorAll('[data-hero]')].map((el) => ({ el, stage: el.querySelector('.pc-hero__stage') }));
    const paintHero = (h) => {
      const r = h.el.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      const p = progress(h.el, h.stage);
      const t = easeOut(clamp(p / .62));
      const s = h.stage.style;
      s.setProperty('--ct', `${(1 - t) * (mobile.matches ? 24 : 16)}%`);
      s.setProperty('--cs', `${(1 - t) * (mobile.matches ? 10 : 28)}%`);
      s.setProperty('--cr', `${(1 - t) * 18}px`);
      s.setProperty('--zs', (1.3 - .3 * t).toFixed(3));
      s.setProperty('--cap-op', clamp((p - .55) / .2).toFixed(3));
    };

    // Parallax: each [data-speed] element drifts at its own speed; collage photos also shift inside their frames
    const floats = [...root.querySelectorAll('[data-speed]')].map((el) => ({ el, speed: parseFloat(el.dataset.speed) || 0, inner: el.querySelector('[data-inner]') }));
    const paintFloats = () => {
      const vh = innerHeight, k = mobile.matches ? .45 : 1;
      floats.forEach((f) => {
        const r = f.el.getBoundingClientRect();
        if (r.bottom < -vh * .5 || r.top > vh * 1.5) return;
        const d = (vh / 2) - (r.top + r.height / 2);
        f.el.style.transform = `translate3d(0, ${(d * f.speed * k).toFixed(1)}px, 0)`;
        if (f.inner) f.inner.style.setProperty('--iy', `${(-d * .06).toFixed(1)}px`);
      });
    };


    // Words: some chapters' words slide sideways as the page scrolls
    const slideWords = [...root.querySelectorAll('[data-slide]')].map((el) => ({ el, first: el.querySelector('span'), dir: +el.dataset.slide }));
    const paintWords = () => slideWords.forEach((w) => {
      const r = w.el.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      const d = (innerHeight / 2) - (r.top + r.height / 2);
      w.el.style.setProperty('--wx', `${(d * .3 * w.dir).toFixed(1)}px`);
    });

    // 02 Horizontal: vertical scrolling moves the strip sideways; photos shift inside their frames
    const hzs = [...root.querySelectorAll('[data-hz]')].map((el) => ({ el, stage: el.querySelector('.hz__stage'), track: el.querySelector('[data-track]'), imgs: [...el.querySelectorAll('[data-hz-img]')] }));
    const paintHz = (h) => {
      const r = h.el.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      const p = progress(h.el, h.stage);
      const dist = Math.max(0, h.track.scrollWidth - innerWidth);
      h.track.style.setProperty('--hx', `${(-p * dist).toFixed(1)}px`);
      h.imgs.forEach((img) => { const b = img.parentElement.getBoundingClientRect(); const dx = (b.left + b.width / 2) - innerWidth / 2; img.style.setProperty('--ix', `${(-dx * .08).toFixed(1)}px`); });
    };

    // 03 Stack: each card shrinks and dims as the next one slides over it
    const stacks = [...root.querySelectorAll('[data-stack-cards]')].map((el) => [...el.querySelectorAll('[data-st-card]')]);
    const paintStack = (cards) => cards.forEach((card, i) => {
      const next = cards[i + 1];
      if (!next) return;
      const a = card.getBoundingClientRect(), b = next.getBoundingClientRect();
      if (a.bottom < -200 || a.top > innerHeight) return;
      const k = clamp(1 - (b.top - a.top) / Math.max(1, a.height));
      card.style.setProperty('--ss', (1 - k * .07).toFixed(3));
      card.style.setProperty('--sb', (1 - k * .45).toFixed(3));
    });

    // 05 Crossfade: one photo dissolves into the next with a slow zoom
    const cfs = [...root.querySelectorAll('[data-cf]')].map((el) => ({ el, stage: el.querySelector('.cf__stage'), slides: [...el.querySelectorAll('[data-cf-slide]')], dots: [...el.querySelectorAll('[data-cf-dot]')] }));
    const paintCf = (c) => {
      const r = c.el.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      const n = c.slides.length;
      const pos = progress(c.el, c.stage) * (n - 1);
      const cur = Math.round(pos);
      c.slides.forEach((sl, i) => {
        // Each new photo fades in over the previous one (which stays solid), so the screen never dims
        const o = i <= Math.floor(pos) ? 1 : clamp((pos - i + 1 - .3) / .4);
        sl.style.setProperty('--co', i === cur ? '1' : '0');
        const t = clamp((pos - i + 1) / 2);
        sl.style.setProperty('--o', o.toFixed(3));
        sl.style.setProperty('--kz', (1.18 - .18 * t).toFixed(3));
        sl.style.setProperty('--kx', ((1 - t) * 3 * +getComputedStyle(sl).getPropertyValue('--dir')).toFixed(2));
        sl.style.zIndex = i + 1;
        sl.classList.toggle('is-live', i === cur);
      });
      c.dots.forEach((d, i) => d.classList.toggle('is-on', i === cur));
    };

    // 06 Split: two photos fly in from the sides and meet in the middle
    const sps = [...root.querySelectorAll('[data-sp]')].map((el) => ({ el, stage: el.querySelector('.sp__stage'), cards: [...el.querySelectorAll('[data-sp-card]')], note: el.querySelector('.sp__note') }));
    const paintSp = (sp) => {
      const r = sp.el.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      const t = easeOut(clamp(progress(sp.el, sp.stage) / .65));
      const m = mobile.matches;
      sp.cards.forEach((card, i) => {
        const side = i ? 1 : -1;
        const x = m ? side * 90 * (1 - t) : side * (24 + 56 * (1 - t));
        const y = m ? side * 18 : side * 4 * t;
        const rot = side * (3 + 14 * (1 - t));
        card.style.transform = `translate(-50%, -50%) translate3d(${x.toFixed(2)}vw, ${y.toFixed(2)}vh, 0) rotate(${rot.toFixed(2)}deg)`;
      });
      sp.stage.style.setProperty('--no', clamp((t - .7) / .3).toFixed(3));
    };

    // Reveal photos and spread words as they come into view
    const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' });
    root.querySelectorAll('.pc-reveal, .pc-word').forEach((el) => io.observe(el));

    // Chapter bar
    const chapters = [...root.querySelectorAll('[data-chapter]')];
    const bar = root.querySelector('[data-bar]');
    const barLinks = [...root.querySelectorAll('[data-jump]')];
    const outro = root.querySelector('[data-outro]');
    const paintBar = () => {
      const start = intro.getBoundingClientRect().bottom < innerHeight * .6;
      const end = outro.getBoundingClientRect().top < innerHeight * .8;
      bar.classList.toggle('is-shown', start && !end);
      let current = -1;
      chapters.forEach((c, i) => { const r = c.getBoundingClientRect(); if (r.top < innerHeight * .5 && r.bottom > innerHeight * .5) current = i; });
      barLinks.forEach((a, i) => (i === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };

    let ticking = false;
    const paint = () => { ticking = false; paintIntro(); heroes.forEach(paintHero); paintFloats(); paintWords(); hzs.forEach(paintHz); stacks.forEach(paintStack); cfs.forEach(paintCf); sps.forEach(paintSp); paintBar(); };
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(paint); } };
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    paint();

    // Chapter links jump straight to the chapter
    root.querySelectorAll('a[href^="#ch-"]').forEach((a) => a.addEventListener('click', (e) => {
      const el = root.querySelector(a.getAttribute('href'));
      if (!el) return;
      e.preventDefault();
      scrollTo({ top: el.getBoundingClientRect().top + scrollY - headerH(), behavior: 'instant' });
    }));
    // Keyboard users: uncover photos as they receive focus, and scroll pinned scenes so the focused photo is on screen
    const toProgress = (el, stage, p) => scrollTo({ top: el.getBoundingClientRect().top + scrollY - headerH() + p * (el.offsetHeight - stage.offsetHeight), behavior: 'instant' });
    root.addEventListener('focusin', (e) => {
      e.target.closest('.pc-reveal')?.classList.add('is-in');
      if (!e.target.matches(':focus-visible')) return;
      const h = hzs.find((x) => x.el.contains(e.target));
      if (h) { const items = [...h.track.children]; const i = items.indexOf(e.target.closest('li')); toProgress(h.el, h.stage, i / Math.max(1, items.length - 1)); }
      const c = cfs.find((x) => x.el.contains(e.target));
      if (c) { const i = c.slides.indexOf(e.target.closest('[data-cf-slide]')); toProgress(c.el, c.stage, i / Math.max(1, c.slides.length - 1)); }
      const sp = sps.find((x) => x.el.contains(e.target));
      if (sp) toProgress(sp.el, sp.stage, .8);
    });
  }
</script>
